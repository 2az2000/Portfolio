# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# Resend API key — required by app/api/contact/route.ts.
# Without it the contact form responds 500 and no mail is sent.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Absolute origin of the deployment. Feeds `metadataBase`, the sitemap,
# robots.txt and every Open Graph URL, so it must be the real public origin
# with no trailing slash. Falls back to https://portfolio-amirali.vercel.app
# when unset — see lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Optional. Only read by `npm run resume:pdf`, which drives a headless
# Chrome or Edge to print public/resume/*.html. Set this if the script cannot
# find a browser on its own.
# CHROME_PATH=
